# Backend (repo root .env)
GEMINI_API_KEY=your-gemini-key
# Model names are configurable — swap here without touching code.
# gemini-2.5-flash-lite is retired for new keys; the 3.5 family is current.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=
JWT_SECRET=generate-a-long-random-secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=dev
INITIAL_ADMIN_EMAIL=admin@ubl-demo.com
INITIAL_ADMIN_PASSWORD=change-me
DEMO_LEARNER_EMAIL=learner@ubl-demo.com
DEMO_LEARNER_PASSWORD=change-me
MAX_UPLOAD_SIZE_MB=10
FRONTEND_ORIGIN=http://localhost:5173

# Frontend (frontend/.env)
# VITE_API_BASE_URL=/api
