  "components": {
    "schemas": {
      "ActivityAdminOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "concept_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "xp": {
            "type": "integer",
            "title": "Xp"
          },
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "difficulty",
          "xp",
          "order",
          "payload"
        ],
        "title": "ActivityAdminOut"
      },
      "ActivityLearnerOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "concept_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concept Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "difficulty": {
            "type": "integer",
            "title": "Difficulty"
          },
          "xp": {
            "type": "integer",
            "title": "Xp"
          },
          "order": {
            "type": "integer",
            "title": "Order"
          },
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "id",
          "type",
          "difficulty",
          "xp",
          "order",
          "data"
        ],
        "title": "ActivityLearnerOut"
      },
      "AdminPasswordReset": {
        "properties": {
          "new_password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "new_password"
        ],
        "title": "AdminPasswordReset"
      },
      "AdminUserCreate": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "pattern": "^(admin|learner)$",
            "title": "Role",
            "default": "learner"
          },
          "language_pref": {
            "type": "string",
            "pattern": "^(en|ur)$",
            "title": "Language Pref",
            "default": "en"
          }
        },
